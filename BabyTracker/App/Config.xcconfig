// BabyTracker Build Configuration
// Copy this file to Config.local.xcconfig and fill in real values.
// NEVER commit Config.local.xcconfig to source control.

// Supabase
SUPABASE_URL = https://your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here

// RevenueCat
REVENUECAT_API_KEY = your-revenuecat-key-here

// Sentry
SENTRY_DSN = your-sentry-dsn-here
